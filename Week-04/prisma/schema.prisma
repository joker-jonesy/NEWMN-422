generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// ONE-TO-ONE
// A User has at most one Profile, and a Profile always belongs
// to exactly one User. The @unique on Profile.userId is what
// makes this "one" instead of "many" — without it, this would
// be a one-to-many relation.
// ─────────────────────────────────────────────────────────────
model User {
  id      Int      @id @default(autoincrement())
  name    String
  email   String   @unique
  profile Profile?
  posts   Post[]

  createdAt DateTime @default(now())
}

model Profile {
  id     Int     @id @default(autoincrement())
  bio    String?
  userId Int     @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// ONE-TO-MANY
// A User can write many Posts; each Post has exactly one author.
// The "many" side (Post) holds the foreign key (authorId).
// ─────────────────────────────────────────────────────────────
model Post {
  id       Int    @id @default(autoincrement())
  title    String
  content  String?
  authorId Int
  author   User   @relation(fields: [authorId], references: [id])

  // implicit many-to-many, see Tag below
  tags Tag[]

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// MANY-TO-MANY (implicit)
// A Post can have many Tags, a Tag can label many Posts.
// Neither side stores a foreign key — Prisma creates and manages
// a hidden join table for us. Use this when the relation itself
// has no extra data attached to it.
// ─────────────────────────────────────────────────────────────
model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}

// ─────────────────────────────────────────────────────────────
// MANY-TO-MANY (explicit)
// A Student can enroll in many Courses, a Course can have many
// Students. Unlike Post <-> Tag, this relation needs its own
// data (grade, enrolledAt), so we model the join table ourselves
// as a real model: Enrollment.
// ─────────────────────────────────────────────────────────────
model Student {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  enrollments Enrollment[]
}

model Course {
  id          Int          @id @default(autoincrement())
  title       String
  code        String       @unique
  enrollments Enrollment[]
}

model Enrollment {
  id         Int      @id @default(autoincrement())
  studentId  Int
  courseId   Int
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grade      String?
  enrolledAt DateTime @default(now())

  // a student can only enroll in the same course once
  @@unique([studentId, courseId])
}
